table dim_product
	lineageTag: 2c2e991e-c1f1-564e-8799-0e98231fd6d6

	column Category
		dataType: string
		lineageTag: 7509b8e8-ae7f-59de-be1e-29ec0bf8446a
		summarizeBy: none
		sourceColumn: Category

	column product_id
		dataType: int64
