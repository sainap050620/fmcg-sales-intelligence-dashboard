{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "p2_bar_rev",
  "position": {
    "x": 20,
    "y": 20,
    "z": 0,
    "height": 330,
    "width": 600,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_channel"
                    }
                  },
                  "Property": "Channel"
                }
              },
              "queryRef": "dim_channel.Channel",
              "nativeQueryRef": "Channel",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Net Revenue"
                }
              },
              "queryRef": "fact_sales.Net Revenue",
              "nativeQueryRef": "Net Revenue"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "fact_sales"
                  }
                },
                "Property": "Net Revenue"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Net Revenue by Channel'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
